
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin role
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USER DATA
    match /users/{userId} {
      // Admins can read/write any user profile
      // Users can read/write their own profile
      allow read, write: if isAdmin() || request.auth.uid == userId;

      // Trainee's exam progress
      match /exams/{examId} {
        allow read: if isAdmin() || request.auth.uid == userId;
        allow write: if isAdmin();
      }
      // Trainee's payment history
      match /payments/{paymentId} {
        allow read: if isAdmin() || request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    // PUBLIC READ, ADMIN WRITE COLLECTIONS
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /licenseCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trafficSignCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trafficSigns/{signId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pricingTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /features/{featureId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SPECIAL CASE COLLECTIONS
    match /pendingTestimonials/{testimonialId} {
        // Any authenticated user can submit a testimonial
        allow create: if request.auth != null;
        // Only admins can read or delete pending testimonials
        allow read, delete: if isAdmin();
        // Nobody can update
        allow update: if false;
    }
    
    match /announcements/{announcementId} {
        // Authenticated users can read announcements
        allow read: if request.auth != null;
        // Admins can create and delete them
        allow create, delete: if isAdmin();
        // Nobody can update
        allow update: if false;
    }
  }
}
